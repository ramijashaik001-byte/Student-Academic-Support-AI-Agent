{
  "regulation": "R23",
  "effective_from": "2023-2024",
  "institution": "Narasaraopeta Engineering College",
  "attendance": {
    "minimum_aggregate_percentage": 75.0,
    "minimum_subject_percentage": 40.0,
    "condonation_range": [
      65.0,
      74.99
    ],
    "condonation_fee_applicable": true,
    "detention_threshold": 65.0,
    "detention_rule": "Students with less than 65% aggregate attendance shall be detained and not permitted to write end-semester examinations."
  },
  "passing_criteria": {
    "end_semester_min_percentage": 35.0,
    "internal_plus_external_min_percentage": 40.0,
    "max_marks_theory": 100,
    "max_marks_internal_theory": 30,
    "max_marks_external_theory": 70,
    "max_marks_lab": 50,
    "max_marks_internal_lab": 15,
    "max_marks_external_lab": 35
  },
  "grading_system": [
    {
      "grade": "O",
      "description": "Outstanding / Superior",
      "marks_range": [
        90,
        100
      ],
      "grade_points": 10
    },
    {
      "grade": "A",
      "description": "Excellent",
      "marks_range": [
        80,
        89
      ],
      "grade_points": 9
    },
    {
      "grade": "B",
      "description": "Very Good",
      "marks_range": [
        70,
        79
      ],
      "grade_points": 8
    },
    {
      "grade": "C",
      "description": "Good",
      "marks_range": [
        60,
        69
      ],
      "grade_points": 7
    },
    {
      "grade": "D",
      "description": "Fair / Average",
      "marks_range": [
        50,
        59
      ],
      "grade_points": 6
    },
    {
      "grade": "E",
      "description": "Satisfactory / Pass",
      "marks_range": [
        40,
        49
      ],
      "grade_points": 5
    },
    {
      "grade": "F",
      "description": "Fail",
      "marks_range": [
        0,
        39
      ],
      "grade_points": 0
    },
    {
      "grade": "Ab",
      "description": "Absent",
      "marks_range": [
        0,
        0
      ],
      "grade_points": 0
    }
  ],
  "formulas": {
    "sgpa": "Sum(Credits_i * GradePoints_i) / Sum(Credits_i)",
    "cgpa": "Sum(Total_Credits_Earned_all_semesters * GradePoints) / Sum(Total_Credits_all_semesters)",
    "percentage_conversion": "(CGPA - 0.5) * 10"
  }
}