# Backend Environment Configuration
# Project: AI Student Academic Support Agent

# Application Settings
PROJECT_NAME="AI Student Academic Support Agent"
SECRET_KEY="academic-support-agent-supersecure-jwt-signing-key-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Default is SQLite. For PostgreSQL: postgresql://username:password@localhost:5432/academic_db
DATABASE_URL="sqlite:///./academic_support.db"

# AI Provider Settings
# Options: "local_fallback", "gemini", "openai"
# The system works 100% offline with zero API keys via local_fallback!
LLM_PROVIDER="local_fallback"
MODEL_NAME="gemini-1.5-flash"

# Optional External API Keys (Leave blank for offline local fallback)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# RAG & Chunking
CHUNK_SIZE=550
CHUNK_OVERLAP=80
RETRIEVAL_TOP_K=4
CONFIDENCE_THRESHOLD=0.40
